<section class="section customers-page">
  <div class="container">
    <div class="customers-hero mb-5">
      <div class="level is-align-items-flex-start">
      <div class="level-left">
        <div>
          <p class="customers-eyebrow mb-2">CRM Directory</p>
          <h1 class="title is-2 mb-2 customers-title">Customers missing email</h1>
          <p class="subtitle is-6 customers-subtitle mb-0">
            Total <%= @customers.size %> customers
          </p>
        </div>
      </div>
      <div class="level-right">
          <div class="buttons">
            <%= link_to "All", root_path, class: "button is-light" %>
            <%= link_to "Alphabetized", customers_alphabetized_path, class: "button is-warning is-light" %>
          </div>
        </div>
      </div>
    </div>
    <div class="columns is-multiline">
      <% @customers.each do |customer| %>
      <div class="column is-12-tablet is-6-desktop">
        <%= render "customer", customer: customer %>
      </div>
      <% end %>
    </div>
  </div>
</section>
