<article class="card" id="<%= dom_id(customer) %>">
  <div class="card-content">
    <div class="media">
      <div class="media-left">
        <figure class="image is-96x96">
          <% if customer.image.attached? %>
            <%= image_tag customer.image, class: "is-rounded", alt: customer.full_name %>
          <% else %>
            <div
              class="has-background-light is-flex is-align-items-center is-justify-content-center is-rounded"
              style="width: 96px; height: 96px;"
            >
              <span class="title is-4 has-text-grey-light">
                <%= customer.full_name.to_s.first&.upcase || "?" %>
              </span>
            </div>
          <% end %>
        </figure>
      </div>

      <div class="media-content">
        <p class="title is-4 mb-2"><%= customer.full_name %></p>

        <% if customer.email.present? %>
          <p class="mb-1">
            <strong>Email:</strong>
            <%= mail_to customer.email %>
          </p>
        <% end %>

        <% if customer.phone_number.present? %>
          <p class="mb-1">
            <strong>Phone Number:</strong>
            <%= customer.phone_number %>
          </p>
        <% end %>

        <p class="is-size-7 has-text-grey">
          Create at <%= l(customer.created_at, format: :long) %>
        </p>
      </div>
    </div>

    <div class="content">
      <p class="has-text-weight-semibold mb-2">Note</p>
      <% if customer.notes.present? %>
        <p><%= simple_format(customer.notes) %></p>
      <% else %>
        <p class="has-text-grey">Doesn't have note yet</p>
      <% end %>
    </div>
  </div>
</article>
